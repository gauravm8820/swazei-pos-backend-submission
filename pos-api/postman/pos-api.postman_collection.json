    {
      "name": "Step 9 - Security, Concurrency & Multi-Tenant Tests",
      "item": [
        {
          "name": "1. Concurrency Safety: Insufficient Inventory (422 Error)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{cashierToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "oversell-test-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productA1Id}}\",\n      \"quantity\": 999\n    }\n  ],\n  \"payment\": {\n    \"method\": \"CASH\",\n    \"amountMinorUnits\": 21978000\n  }\n}"
            },
