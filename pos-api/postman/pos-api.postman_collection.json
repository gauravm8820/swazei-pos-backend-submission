{
  "info": {
    "_postman_id": "a90dfb12-9214-411a-8bb7-e9a9a3b2b001",
    "name": "Multi-Tenant POS API (Swazei Tech)",
    "description": "Comprehensive Postman collection for Swazei Tech Senior Backend Engineer Take-Home Assignment.\nCovers multi-tenant authentication, catalog management, inventory, sales transactions, idempotency, and error scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "cashierToken", "value": "", "type": "string" },
    { "key": "ownerToken", "value": "", "type": "string" },
    { "key": "store1Id", "value": "11111111-1111-4000-8000-000000000011", "type": "string" },
    { "key": "store3Id", "value": "22222222-2222-4000-8000-000000000013", "type": "string" },
    { "key": "productA1Id", "value": "11111111-1111-4000-8000-000000000031", "type": "string" },
    { "key": "productA2Id", "value": "11111111-1111-4000-8000-000000000032", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Cashier S1 (Store 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('cashierToken', res.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cashier-s1@merchant.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as Owner A (Merchant A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('ownerToken', res.data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner-a@merchant.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashierToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "2. Products Catalog",
      "item": [
        {
          "name": "List Merchant Products (Cached in Redis)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashierToken}}" }],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashierToken}}" }],
            "url": { "raw": "{{baseUrl}}/products/{{productA1Id}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productA1Id}}"] }
          }
        },
        {
          "name": "Create Product (Admin/Owner)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vanilla Latte\",\n  \"description\": \"Double shot espresso with vanilla and steamed milk\",\n  \"priceMinorUnits\": 28000,\n  \"currency\": \"INR\",\n  \"sku\": \"LAT-VAN-001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        }
      ]
    },
    {
      "name": "3. Inventory",
      "item": [
        {
          "name": "List Store Inventory",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashierToken}}" }],
            "url": { "raw": "{{baseUrl}}/stores/{{store1Id}}/inventory", "host": ["{{baseUrl}}"], "path": ["stores", "{{store1Id}}", "inventory"] }
          }
        },
        {
          "name": "Get Specific Product Stock",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashierToken}}" }],
            "url": { "raw": "{{baseUrl}}/stores/{{store1Id}}/inventory/{{productA1Id}}", "host": ["{{baseUrl}}"], "path": ["stores", "{{store1Id}}", "inventory", "{{productA1Id}}"] }
          }
        },
        {
          "name": "Update Product Stock (Manager/Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 25\n}"
            },
            "url": { "raw": "{{baseUrl}}/stores/{{store1Id}}/inventory/{{productA1Id}}", "host": ["{{baseUrl}}"], "path": ["stores", "{{store1Id}}", "inventory", "{{productA1Id}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Sales & POS Transactions",
      "item": [
        {
          "name": "Create Sale — Success Path",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashierToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productA2Id}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"paymentMetadata\": {\n    \"simulateFailure\": false\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/stores/{{store1Id}}/sales", "host": ["{{baseUrl}}"], "path": ["stores", "{{store1Id}}", "sales"] }
          }
        },
        {
          "name": "Create Sale — Idempotency Replay (Send same request twice)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashierToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "fixed-idempotency-key-demo-12345" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productA2Id}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/stores/{{store1Id}}/sales", "host": ["{{baseUrl}}"], "path": ["stores", "{{store1Id}}", "sales"] }
          }
        },
        {
          "name": "Create Sale — Payment Failure (Simulate Decline & Stock Restored)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashierToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productA1Id}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"paymentMetadata\": {\n    \"simulateFailure\": true\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/stores/{{store1Id}}/sales", "host": ["{{baseUrl}}"], "path": ["stores", "{{store1Id}}", "sales"] }
          }
        },
        {
          "name": "Create Sale — Insufficient Inventory (422 Error)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashierToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productA1Id}}\",\n      \"quantity\": 9999\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/stores/{{store1Id}}/sales", "host": ["{{baseUrl}}"], "path": ["stores", "{{store1Id}}", "sales"] }
          }
        },
        {
          "name": "Cross-Tenant Access Test — Store 3 (Merchant B) using Merchant A token (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashierToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productA1Id}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/stores/{{store3Id}}/sales", "host": ["{{baseUrl}}"], "path": ["stores", "{{store3Id}}", "sales"] }
          }
        },
        {
          "name": "List Store Sales",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashierToken}}" }],
            "url": { "raw": "{{baseUrl}}/stores/{{store1Id}}/sales", "host": ["{{baseUrl}}"], "path": ["stores", "{{store1Id}}", "sales"] }
          }
        }
      ]
    },
    {
      "name": "5. System Health",
      "item": [
        {
          "name": "Health Check (DB + Redis)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    }
  ]
}
