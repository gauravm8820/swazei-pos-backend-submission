# ─────────────────────────────────────────────────────────────────────────────
# POS API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pos_db
DATABASE_TEST_NAME=pos_test

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty if no password
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a long, random secret in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_me_refresh_secret_also_long_and_random
JWT_REFRESH_EXPIRES_IN=7d

# ── Mock Payment Provider ─────────────────────────────────────────────────────
# Simulated processing delay in milliseconds
MOCK_PAYMENT_DELAY_MS=50
# Probability of failure (0.0 = always succeed, 1.0 = always fail)
MOCK_PAYMENT_FAIL_RATE=0
