  "info": {
    "title": "Multi-Tenant POS API",
    "description": "POS Sales & Inventory API with multi-tenancy, pessimistic locking, and idempotency",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "cashier@store1.com"
          },
          "password": {
            "type": "string",
            "example": "securepassword123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "cashier@store1.com"
          },
          "password": {
            "type": "string",
            "example": "securepassword123",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "SUPER_ADMIN",
              "OWNER",
              "ADMIN",
              "MANAGER",
              "CASHIER"
            ],
            "example": "CASHIER"
          },
          "storeId": {
            "type": "string",
            "example": "uuid-of-store"
          }
        },
        "required": [
          "email",
          "password",
          "role"
        ]
      },
      "CreatePlanDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Growth Plan"
          },
          "slug": {
            "type": "string",
            "example": "growth-plan"
          },
          "description": {
            "type": "string",
            "example": "Best for expanding retail businesses with up to 5 stores"
          },
          "priceMinorUnits": {
            "type": "number",
            "example": 499900,
            "description": "Price in minor units (paise/cents), e.g. 499900 = ₹4,999"
          },
          "currency": {
            "type": "string",
            "example": "INR",
            "default": "INR"
          },
          "durationMonths": {
            "type": "number",
            "example": 6,
            "description": "Validity duration in months"
          },
          "maxStores": {
            "type": "number",
            "example": 5,
            "description": "Maximum stores allowed under this plan"
          },
          "maxUsers": {
            "type": "number",
            "example": 20,
            "description": "Maximum staff users allowed under this plan"
          },
          "features": {
            "example": [
              "Multi-store inventory",
              "Real-time sales analytics",
              "Redis caching"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "default": true
          }
        },
        "required": [
          "name",
          "slug",
          "priceMinorUnits",
          "durationMonths",
          "maxStores",
          "maxUsers"
        ]
      },
      "UpdatePlanDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Growth Plan"
          },
          "slug": {
            "type": "string",
            "example": "growth-plan"
          },
          "description": {
            "type": "string",
            "example": "Best for expanding retail businesses with up to 5 stores"
          },
          "priceMinorUnits": {
            "type": "number",
            "example": 499900,
            "description": "Price in minor units (paise/cents), e.g. 499900 = ₹4,999"
          },
          "currency": {
            "type": "string",
            "example": "INR",
            "default": "INR"
          },
          "durationMonths": {
            "type": "number",
            "example": 6,
            "description": "Validity duration in months"
          },
          "maxStores": {
            "type": "number",
            "example": 5,
            "description": "Maximum stores allowed under this plan"
          },
          "maxUsers": {
            "type": "number",
            "example": 20,
            "description": "Maximum staff users allowed under this plan"
          },
          "features": {
            "example": [
              "Multi-store inventory",
              "Real-time sales analytics",
              "Redis caching"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "default": true
          }
        }
      },
      "AssignSubscriptionDto": {
        "type": "object",
        "properties": {
          "merchantId": {
            "type": "string",
            "example": "uuid-of-merchant"
          },
          "planId": {
            "type": "string",
            "example": "uuid-of-plan"
          },
          "planSlug": {
            "type": "string",
            "example": "growth",
            "description": "Plan slug (alternative to planId)"
          },
          "durationMonths": {
